# Copy to .env and fill in your own values. Never commit .env.

# Telegram bot tokens from @BotFather
ilon_token=
volya_token=

# OpenRouter
OPENROUTER_API_KEY=
# MODEL=  (optional: each bot has its own default model)

# Comma-separated Telegram user IDs allowed to use the bots
ALLOWED_USER_IDS=

HISTORY_LIMIT=12

# Webhook mode for hosting (e.g. Render)
USE_WEBHOOK=0
WEBHOOK_BASE=
WEBHOOK_SECRET=
PORT=8080
